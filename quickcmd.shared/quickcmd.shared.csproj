<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>quickcmd.shared</AssemblyName>
    <RootNamespace>QuickCmd</RootNamespace>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <!-- 公用类型保持 internal，仅对三个可执行客户端开放 -->
    <InternalsVisibleTo Include="quickcmd" />
    <InternalsVisibleTo Include="qchost" />
    <InternalsVisibleTo Include="qcApp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 配套 agent skill 文档：嵌入 shared.dll，CLI（skill / install-skill）与
         托盘 app（安装 Agent Skill 菜单项）共用同一份资源 -->
    <EmbeddedResource Include="..\traycmd\skills\traycmd\SKILL.md">
      <LogicalName>skill.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
