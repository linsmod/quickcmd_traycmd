<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>qchost</AssemblyName>
    <RootNamespace>QuickCmd</RootNamespace>
    <Version>1.0.0</Version>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\quickcmd.shared\quickcmd.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 页面独立成文件：随输出复制，运行时优先读磁盘，改完刷新即可；内嵌副本仅作兜底 -->
    <None Update="web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="web\index.html" LogicalName="QuickCmd.WebConsole.html" />
  </ItemGroup>

</Project>
